---
import Layout from '../../layouts/Layout.astro';
import BigWalkDoll from '../../assets/bigwalkdollphoto.png';
import TGYHDoll from '../../assets/tgyhcrochetdollphoto.jpeg';

---

<Layout title="Patterns">

	  <div class="bg-gray-50 mb-10 pt-3 py-16 lg:px-[300px] lg:py-10">
	    <div class="text-center mt-5 underline decoration-3 decoration-(--color-dandelion) underline-offset-2 text-4xl">
			<a 
			href="/patterns"
			class="mt-5 hover:decoration-(--color-dark-teal) font-semibold text-gray-800 hover:text-black" 
			title="Patterns"
			>
			Patterns</a>
		</div>

		<div class="px-5 mx-10 md:max-w-md">

		<section class="bg-(--color-blush)/50 rounded-lg my-9 p-6">
			<h2 class="font-semibold text-center text-2xl">NEW!</h2>
<a 
			href="/patterns/bigwalkcrochetdoll"
			class="" 
			title="Big Walk Crochet Doll Pattern"
			>
			
    <img
      alt="Big Walk Crochet Doll Photo"
      title="Big Walk Doll Photo"
      class="mt-4 max-h-50 md:max-h-70 object-cover"
      decoding="auto"
      src={BigWalkDoll.src}
      loading="lazy"
    />
				<h3 class="mt-3 text-2xl underline underline decoration-3 decoration-blue-700 underline-offset-2 hover:decoration-red-700 font-semibold text-gray-800 hover:text-black">
      Big Walk Crochet Doll Pattern
				</h3>
				<p class="mt-2">Free</p>
				</a>
			</section>

		<div>
<a 
			href="/patterns/tgyhcrochetdoll"
			class="" 
			title="Thank Goodness You're Here Crochet Doll Pattern"
			>
			
    <img
      alt="TGYH Crochet Doll Photo"
      title="TGYH Crochet Doll Photo"
      class="mt-8 max-h-50 md:max-h-70 object-cover"
      decoding="auto"
      src={TGYHDoll.src}
      loading="lazy"
    />
				<h3 class="mt-3 text-2xl underline underline decoration-3 decoration-orange-400 underline-offset-2 hover:decoration-indigo-600 font-semibold text-gray-800 hover:text-black">
      Thank Goodness You're Here Crochet Doll Pattern
				</h3>
				<p class="my-2">Free</p>

				</a>

				
		</div>
	</div>
	</div>

</Layout>
