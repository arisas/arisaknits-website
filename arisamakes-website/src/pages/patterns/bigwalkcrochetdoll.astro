---
import Layout from '../../layouts/Layout.astro';
import BigWalkDoll from '../../assets/bigwalkdollphoto.png';
---

<Layout title="Big Walk Crochet Doll Pattern">

  <div class="bg-gray-50 mb-10 pt-6 px-5 lg:px-[300px] lg:py-10">
    <div class="text-center mt-5 text-4xl">
			<h1><a 
			href="/patterns"
			class="mt-5 underline decoration-3 decoration-(--color-dandelion) underline-offset-2 hover:decoration-(--color-dark-teal) font-semibold text-gray-800 hover:text-black" 
			title="Patterns"
			>
			Patterns</a>
      </h1>
		</div>

    <h2 class="mt-8 text-3xl font-semibold">
      Big Walk Crochet Doll Pattern
    </h2>

    <img
      alt="Big Walk Crochet Doll Photo"
      title="Big Walk Crochet Doll Photo"
      class="mt-8 max-h-80 md:max-h-100 object-cover"
      decoding="auto"
      src={BigWalkDoll.src}
      loading="lazy"
    />


    <h3 class="mt-8 text-2xl font-bold text-gray-800">Supplies Needed:</h3>

    <ul class="mt-2 list-none text-xl text-gray-600">
      <li>Crochet hook: 2.75mm (smaller) and 4mm (larger)</li>
      <li>Darning Needle</li>
      <li>Stuffing (you can use scrap yarn to stuff too!)</li>
      <li>Worsted weight yarn in:</li>
    </ul>


    <ul class="mt-2 list-inside list-disc text-xl text-gray-600">
      <li>Your selected colors for the head, torso, and bottom</li>
      <li>White and black for the eyes</li>
    </ul>

    

         <div
        class="mt-5 bg-(--color-blush)/20 text-xl rounded-lg md:mx-40 px-4 py-3"
      >
        <h4 class="pl-10 font-bold text-center">Changelog:</h4>
            <ul class="mt-2 list-inside list-disc text-xl text-gray-600">
              <li>New: Flare Gun pattern</li>
              <li>New: Backpack pattern</li>
              <li>Include photos of row 17 and 18 to start the Left Leg section</li>
              <li>Fixed instructions for the Right Leg and Foot section for more accurate steps</li>
              <li>Fixed instructions for The Red Object to "..if you want to sew The Red Object to a backpack or hands."</li>
    </ul>
      </div>

      <p class="my-3">Last Updated: V1.1 on August 27, 2026</p>

    <div class="mt-8">
        <a
      class="text-lg p-2 touch-manipulation rounded-lg bg-(--color-dark-teal) font-medium text-white hover:bg-teal-900 disabled:cursor-not-allowed disabled:bg-slate-50 disabled:text-slate-500"
     href="/bigwalkcrochetdollpattern-v1.1.pdf"
     target="_blank"
    >
      Download Pattern
    </a>
    </div>

</div>

</Layout>
